# Scrawly works with NO configuration. Everything below is optional.
# Copy this file to `.env` in the Scrawly folder and fill in only what you need.
# `.env` is ignored by git, so your keys never leave your machine.

# --- Performance data (Core Web Vitals) -------------------------------------
# Free Google PageSpeed Insights API key: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# --- AI-assisted rewrites (bring your own key) --------------------------------
# Anthropic or any OpenAI-compatible endpoint. You can also set these in the app
# under Settings.
SCRAWLY_AI_KIND=            # anthropic | openai
SCRAWLY_AI_MODEL=
SCRAWLY_AI_KEY=
SCRAWLY_AI_BASE_URL=        # only for OpenAI-compatible providers

# Optional embeddings provider (topic clustering, near-duplicate content).
SCRAWLY_EMBED_MODEL=
SCRAWLY_EMBED_KEY=
SCRAWLY_EMBED_BASE_URL=

# --- Google Search Console (optional) ----------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=   # path to a service-account JSON file
SCRAWLY_GOOGLE_OAUTH_CLIENT=      # or: OAuth client JSON path
SCRAWLY_GOOGLE_OAUTH_TOKEN=

# --- Backlink data (optional) ---------------------------------------------------
SCRAWLY_AHREFS_TOKEN=
SCRAWLY_MAJESTIC_KEY=
SCRAWLY_MOZ_ACCESS_ID=
SCRAWLY_MOZ_SECRET_KEY=

# --- Crawling sites behind a login form (optional) -----------------------------
SCRAWLY_FORM_LOGIN_URL=
SCRAWLY_FORM_USER=
SCRAWLY_FORM_PASS=

# --- WordPress fixes ------------------------------------------------------------
# Normally you connect WordPress inside the app with the Scrawly Connector plugin;
# nothing is needed here. Advanced alternative (core REST + Application Password):
# SCRAWLY_WP_APP_PASS must be Fernet-encrypted with SCRAWLY_ENCRYPTION_KEY.
SCRAWLY_WP_URL=
SCRAWLY_WP_USER=
SCRAWLY_WP_APP_PASS=
SCRAWLY_ENCRYPTION_KEY=

# --- App behaviour --------------------------------------------------------------
SCRAWLY_AUTO_UPDATE=1        # 0 = don't check GitHub for updates on launch
SCRAWLY_DATA_DIR=            # where audits are stored (default: your user data folder)
SCRAWLY_PORT=                # fixed local port for the app's built-in server
SCRAWLY_FEEDBACK_URL=        # where in-app feedback notes are sent
